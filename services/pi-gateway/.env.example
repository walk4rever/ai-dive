# Supabase — direct connection (not pgbouncer)
DIRECT_URL="postgresql://postgres:[DB_PASSWORD]@db.vlaawtpxqzclhmhrlwti.supabase.co:5432/postgres"

# pi agent config dir — contains models.json (custom provider + API key)
# Local dev: reuse ~/.pi/agent (shared with pi CLI)
# Production (air7): set PI_AGENT_DIR=~/pi-gateway-ai-dive/.pi-agent
PI_AGENT_DIR="~/.pi/agent"

# Gateway auth — shared secret between Next.js and this service
# Must match AI_DIVE_AGENT_SECRET in ai-dive .env.local
AGENT_SECRET="change-me-in-production"

# Port (default 3457 — buffett-tribe uses 3456)
PORT=3458

# GitHub token — optional, raises rate limit from 60 to 5000 req/hr
# Only needed for analyze_github on private repos or high-traffic usage
# GITHUB_TOKEN="ghp_..."
