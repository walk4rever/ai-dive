# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
services/*/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/wiki-site/public/
/wiki-site/quartz/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/

# supabase CLI local cache (e.g. supabase/.temp/cli-latest) — not project config
supabase/.temp/

# session-to-session working notes — not versioned project documentation
# (the canonical docs are README.md / PRODUCT.md / TODO.md)
/handoff.md
